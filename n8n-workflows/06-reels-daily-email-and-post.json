    {
      "id": "ed2ea332-26d7-4631-8080-95be6cd95e4c",
      "name": "Check reel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        600
      ],
      "parameters": {
        "jsCode": "\n// Instagram allows max 5 hashtags. Claude updates these pools regularly.\nconst POOLS = {\n  Hindi:     { fixed: ['#fruitseller', '#फलवाला'], rotate: ['#fruitshop', '#onlinedukaan', '#smallbusinessindia', '#fruitwala', '#फलकीदुकान', '#dukaan', '#vocalforlocal', '#localbusiness', '#fruitmarket', '#fruitifyindia', '#mandi', '#digitalindia'] },\n  Tamil:     { fixed: ['#fruitseller', '#பழக்கடை'], rotate: ['#chennai', '#coimbatore', '#madurai', '#tamilnadu', '#trichy', '#fruitshop', '#fruitifyindia'] },\n  Telugu:    { fixed: ['#fruitseller', '#fruitshop'], rotate: ['#hyderabad', '#vijayawada', '#visakhapatnam', '#telangana', '#andhrapradesh', '#warangal', '#fruitifyindia'] },\n  Bengali:   { fixed: ['#fruitseller', '#ফলেরদোকান'], rotate: ['#kolkata', '#westbengal', '#siliguri', '#howrah', '#durgapur', '#fruitshop', '#fruitifyindia'] },\n  Marathi:   { fixed: ['#fruitseller', '#फळविक्रेता'], rotate: ['#mumbai', '#pune', '#nashik', '#nagpur', '#maharashtra', '#fruitshop', '#fruitifyindia'] },\n  Gujarati:  { fixed: ['#fruitseller', '#fruitshop'], rotate: ['#ahmedabad', '#surat', '#vadodara', '#rajkot', '#gujarat', '#fruitifyindia'] },\n  Punjabi:   { fixed: ['#fruitseller', '#fruitshop'], rotate: ['#ludhiana', '#amritsar', '#jalandhar', '#chandigarh', '#punjab', '#fruitifyindia'] },\n  Kannada:   { fixed: ['#fruitseller', '#fruitshop'], rotate: ['#bengaluru', '#mysuru', '#hubli', '#mangaluru', '#karnataka', '#fruitifyindia'] },\n  Malayalam: { fixed: ['#fruitseller', '#fruitshop'], rotate: ['#kochi', '#kerala', '#thiruvananthapuram', '#kozhikode', '#thrissur', '#fruitifyindia'] }\n};\nfunction withTags(caption, lang) {\n  const p = POOLS[lang] || POOLS.Hindi;\n  const day = Math.floor(Date.now() / 86400000) * 3 + Math.floor(Math.random() * 3);\n  const pick = [];\n  for (let i = 0; pick.length < 3 && i < p.rotate.length * 2; i++) { const t = p.rotate[(day + i) % p.rotate.length]; if (!pick.includes(t)) pick.push(t); }\n  const text = String(caption || '').replace(/(^|\\s)#[^\\s#]+/g, '').replace(/\\n{3,}/g, '\\n\\n').trim();\n  return text + '\\n\\n' + p.fixed.concat(pick).slice(0, 5).join(' ');\n}\n\nconst b = $('Post confirmed').first().json.body || {};\nconst r = $input.all().map(x => x.json).find(x => String(x.ID) === String(b.id));\nconst ok = b.k === '<APPROVAL_KEY>' && r && String(r.Status) === 'Ready';\nreturn [{ json: { ok: !!ok, id: r ? r.ID : '', status: r ? r.Status : '', video: r ? 'https://raw.githubusercontent.com/expertresourcing/fruitify-reels/main/' + r.Video : '', caption: r ? withTags(r.Caption, r.Language) : '', lang: r ? r.Language : '', hook: r ? r.Hook : '' } }];\n"
      }
    },
