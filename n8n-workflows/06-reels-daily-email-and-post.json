        440,
        0
      ],
      "parameters": {
        "jsCode": "const page = (title, body) => '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>FRUiTIFY reels</title><style>body{font-family:Arial,sans-serif;max-width:620px;margin:24px auto;padding:0 16px;color:#222}button{background:#1f7a4a;color:#fff;border:0;padding:14px 26px;border-radius:8px;font-size:17px}.box{background:#f5f5f5;padding:10px;border-radius:8px;white-space:pre-wrap;font-size:15px}video{width:100%;max-height:70vh;border-radius:10px;background:#000}</style></head><body><h2 style=\"color:#1f5f3f\">' + title + '</h2>' + body + '</body></html>';\nconst esc = s => String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\"/g,'&quot;');\n\nconst today = $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd');\nconst rows = $input.all().map(r => r.json).filter(r => String(r['Post date']) <= today && String(r.Status) === 'Ready');\nif (!rows.length) return [];\nconst cards = rows.map(r => '<div style=\"border:1px solid #dde;border-radius:10px;padding:14px;margin:14px 0\"><p style=\"margin:0 0 6px\"><b>' + esc(r.Language) + '</b> · ' + esc(r['Post date']) + '</p><p style=\"font-size:18px;margin:6px 0\"><b>' + esc(r.Hook) + '</b></p><p><a href=\"https://raw.githubusercontent.com/expertresourcing/fruitify-reels/main/' + esc(r.Video) + '\">▶ Watch the reel</a></p><p><a href=\"https://fruitifyindia.app.n8n.cloud/webhook/fruitify-reel?k=<APPROVAL_KEY>&id=' + encodeURIComponent(r.ID) + '\" style=\"background:#1f7a4a;color:#fff;padding:12px 22px;border-radius:8px;text-decoration:none;font-size:16px;display:inline-block\">Review &amp; post</a></p></div>').join('');\nconst html = '<div style=\"font-family:Arial,sans-serif;max-width:620px\">' + '<p>Good morning! ' + rows.length + ' reel(s) ready for today. Tap <b>Review &amp; post</b>, check it, then tap <b>Post on Instagram</b> once.</p>' + cards + '<p style=\"color:#888;font-size:12px\">Reels not posted stay in this list on the next days.</p></div>';\nreturn [{ json: { subject: 'FRUiTIFY reels to post today (' + rows.length + ')', html } }];\n"
      }
    },
