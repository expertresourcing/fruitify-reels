    {
      "id": "cfafccb5-e279-4251-b758-85b8c73b0c52",
      "name": "Reel review page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const page = (title, body) => '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>FRUiTIFY reels</title><style>body{font-family:Arial,sans-serif;max-width:620px;margin:24px auto;padding:0 16px;color:#222}button{background:#1f7a4a;color:#fff;border:0;padding:14px 26px;border-radius:8px;font-size:17px}.box{background:#f5f5f5;padding:10px;border-radius:8px;white-space:pre-wrap;font-size:15px}video{width:100%;max-height:70vh;border-radius:10px;background:#000}</style></head><body><h2 style=\"color:#1f5f3f\">' + title + '</h2>' + body + '</body></html>';\nconst esc = s => String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\"/g,'&quot;');\n\nconst q = $('Reel review opened').first().json.query || {};\nif (q.k !== '<APPROVAL_KEY>') return [{ json: { html: page('Link not valid', '') } }];\nconst r = $input.all().map(x => x.json).find(x => String(x.ID) === String(q.id));\nif (!r) return [{ json: { html: page('Not found', '') } }];\nif (String(r.Status) !== 'Ready') return [{ json: { html: page('Already done ✓', '<p>This reel is already <b>' + esc(r.Status) + '</b>.</p>' + (r['Instagram link'] ? '<p><a href=\"' + esc(r['Instagram link']) + '\">Open it on Instagram</a></p>' : '')) } }];\nconst body = '<p><b>' + esc(r.Language) + '</b> reel</p><video src=\"https://raw.githubusercontent.com/expertresourcing/fruitify-reels/main/' + esc(r.Video) + '\" controls playsinline preload=\"metadata\"></video><p><b>Caption</b></p><div class=\"box\">' + esc(r.Caption) + '</div>' +\n '<form method=\"POST\" style=\"margin-top:18px\" onsubmit=\"var b=this.querySelector(\\'button\\');b.disabled=true;b.textContent=\\'Posting… please wait\\';\"><input type=\"hidden\" name=\"k\" value=\"' + esc(q.k) + '\"><input type=\"hidden\" name=\"id\" value=\"' + esc(r.ID) + '\"><button>Post on Instagram</button></form><p style=\"color:#888;font-size:13px\">Posts to @fruitify.india.byanay. Tap once.</p>';\nreturn [{ json: { html: page('Review reel', body) } }];\n"
      }
    },
