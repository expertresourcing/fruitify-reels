      "parameters": {
        "jsCode": "const page = (title, body) => '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>FRUiTIFY reels</title><style>body{font-family:Arial,sans-serif;max-width:620px;margin:24px auto;padding:0 16px;color:#222}button{background:#1f7a4a;color:#fff;border:0;padding:14px 26px;border-radius:8px;font-size:17px}.box{background:#f5f5f5;padding:10px;border-radius:8px;white-space:pre-wrap;font-size:15px}video{width:100%;max-height:70vh;border-radius:10px;background:#000}</style></head><body><h2 style=\"color:#1f5f3f\">' + title + '</h2>' + body + '</body></html>';\nconst esc = s => String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\"/g,'&quot;');\n\nreturn [{ json: { html: page('Posting… ✓', '<p>Instagram is processing the <b>' + esc($('Check reel').first().json.lang) + '</b> reel now. It takes 1–3 minutes.</p><p>You will get an email when it is live. You can close this page.</p>') } }];\n"
