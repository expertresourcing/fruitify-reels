  {
   "id": "eae265db-d6f0-4a7a-a57a-a4ed801833cd",
   "name": "Prepare row and email",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    0
   ],
   "parameters": {
    "jsCode": "\nconst f = $('Hindi sign-up form').first().json;\nconst g = k => String(Object.entries(f).find(([key]) => key.startsWith(k))?.[1] ?? '').trim();\nconst shop = g('दुकान / बिज़नेस'), owner = g('मालिक'), phoneRaw = g('मोबाइल नंबर'), city = g('शहर');\nconst phone = phoneRaw.replace(/\\D/g, '').replace(/^(91|0)(?=\\d{10}$)/, '');\nconst wanted = g('आपकी वेबसाइट').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst fromShop = shop.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]/g, '');\nlet base = (wanted || fromShop || ('shop' + phone.slice(-4))).slice(0, 20);\nconst used = new Set($input.all().map(r => String(r.json['Business ID (suggested)'] || '').toLowerCase()));\nlet id = base, n = 2; while (used.has(id)) id = base + n++;\nconst row = { 'Submitted on': $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd HH:mm'), 'Business ID (suggested)': id, 'Shop name': shop, 'Owner name': owner,\n  'Mobile (WhatsApp)': phone, 'City': city, 'Shop address': g('दुकान का पूरा पता'), 'Uses': g('आप FRUiTIFY किस पर'), 'Number of shops': g('आपकी कितनी दुकानें'),\n  'Preferred web name': wanted, 'Instagram / Facebook': g('Instagram'), 'Email': g('ईमेल'), 'Fruits sold': g('आप कौन-कौन'), 'Status': 'New - waiting for onboarding', 'Onboarded on': '', 'Notes': '' };\nconst phoneOnly = /सिर्फ़ मोबाइल/.test(row['Uses']);\nconst welcome = 'नमस्ते ' + owner + ' जी 🙏\\nFRUiTIFY में आपका स्वागत है! आपकी दुकान \"' + shop + '\" ऑनलाइन तैयार है।\\n\\n🌐 आपकी दुकान का लिंक: https://' + id + '.fruitifyindia.com\\n🔑 Business ID: ' + id + '\\n🔢 आपका 7 अंकों का PIN: (यहाँ PIN लिखें)\\n\\n' +\n  (phoneOnly ? 'अपने मोबाइल में Chrome खोलकर ऊपर वाला लिंक खोलें और \"Business\" बटन से लॉगिन करें। चाहें तो Chrome मेनू से \"होम स्क्रीन पर जोड़ें\" दबाएँ - फिर यह ऐप की तरह खुलेगा।' : 'मोबाइल या कंप्यूटर पर ऊपर वाला लिंक खोलें और \"Business\" बटन से लॉगिन करें।') +\n  '\\nपहली बार लॉगिन पर अपनी दुकान की बाकी जानकारी (GST, फ़र्म का नाम आदि) खुद भरें।\\n2 महीने का फ्री ट्रायल शुरू हो गया है। कोई भी मदद चाहिए तो इसी नंबर पर मैसेज करें।\\n- अंकुर, FRUiTIFY';\nconst wa = 'https://wa.me/91' + phone + '?text=' + encodeURIComponent(welcome);\nconst esc = s => String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;');\nconst html = '<div style=\"font-family:Arial,sans-serif;max-width:640px\"><h2 style=\"color:#1f5f3f\">New shop wants to join: ' + esc(shop) + '</h2>' +\n  '<table cellpadding=\"6\" style=\"border-collapse:collapse;font-size:15px\">' + Object.entries(row).filter(([k]) => !['Status','Onboarded on','Notes'].includes(k)).map(([k, v]) => '<tr><td style=\"color:#666\">' + esc(k) + '</td><td><b>' + esc(v) + '</b></td></tr>').join('') + '</table>' +\n  '<h3>To onboard (Platform Owner console)</h3><ol><li>Onboard a New Business Chain: business name <b>' + esc(shop) + '</b>, Business Owner <b>' + esc(owner) + '</b>, phone <b>' + esc(phone) + '</b>, Business ID <b>' + esc(id) + '</b>.</li><li>Note the 7-digit PIN you set.</li><li>Tap the button below - WhatsApp opens with the Hindi welcome message ready. Type the PIN where it says \"(यहाँ PIN लिखें)\" and send.</li><li>In the CRM sheet, Onboarding tab, set Status to \"Onboarded\".</li></ol>' +\n  '<p><a href=\"' + wa + '\" style=\"background:#25D366;color:#fff;padding:12px 22px;border-radius:8px;text-decoration:none;font-weight:bold\">Open WhatsApp with welcome message</a></p>' +\n  (phoneOnly ? '<p style=\"color:#a15c00\"><b>Note:</b> this owner will use only a mobile phone.</p>' : '') + '</div>';\nreturn [{ json: { row, subject: 'New shop sign-up: ' + shop + ' (' + city + ')', html } }];\n"
   }
